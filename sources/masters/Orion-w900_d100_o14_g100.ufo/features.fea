@MarkAboveLC = [acutecomb brevecomb caroncomb circumflexcomb commaturnedabovecomb dieresiscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb ringcomb
    tildecomb uni03020300 uni03020301 uni03020303 uni03020309 uni03060300 uni03060301 uni03060303 uni03060309];
@MarkAboveCase = [acutecomb.case brevecomb.case caroncomb.case circumflexcomb.case commaturnedabovecomb.case dieresiscomb.case dotaccentcomb.case gravecomb.case hookabovecomb.case hungarumlautcomb.case macroncomb.case ringcomb.case
    tildecomb.case uni03020300.case uni03020301.case uni03020303.case uni03020309.case uni03060300.case uni03060301.case uni03060303.case uni03060309.case];
@CombAbove = [acutecomb brevecomb caroncomb circumflexcomb commaturnedabovecomb dieresiscomb dieresistonoscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb
    ringcomb tildecomb tonoscomb uni03020300 uni03020301 uni03020303 uni03020309 uni03060300 uni03060301 uni03060303 uni03060309];
@CombBelow = [cedillacomb commaaccentcomb dotbelowcomb macronbelowcomb ogonekcomb];
@Fig = [zero one two three four five six seven eight nine];
@FigTab = [zero.tf one.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf];
@FigAll = [zero one two three four five six seven eight nine zero.tf one.tf
    two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf zero.zero zero.zero.tf];
@Numr = [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr];
@Dnom = [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];
@Sups = [zero.sups one.sups two.sups three.sups four.sups five.sups six.sups seven.sups eight.sups nine.sups];
@Subs = [zero.subs one.subs two.subs three.subs four.subs five.subs six.subs seven.subs eight.subs nine.subs];

feature ccmp {
  lookup ccmp_viet {
    sub circumflexcomb acutecomb by uni03020301;
    sub circumflexcomb gravecomb by uni03020300;
    sub circumflexcomb hookabovecomb by uni03020309;
    sub circumflexcomb tildecomb by uni03020303;
    sub brevecomb acutecomb by uni03060301;
    sub brevecomb gravecomb by uni03060300;
    sub brevecomb hookabovecomb by uni03060309;
    sub brevecomb tildecomb by uni03060303;
  } ccmp_viet;
  lookup ccmp_dotless {
    sub i' @CombAbove by dotlessi;
    sub i' @CombBelow @CombAbove by dotlessi;
    sub j' @CombAbove by dotlessj;
    sub j' @CombBelow @CombAbove by dotlessj;
    sub uni0456' @CombAbove by dotlessi;
    sub uni0456' @CombBelow @CombAbove by dotlessi;
    sub uni0458' @CombAbove by dotlessj;
    sub uni0458' @CombBelow @CombAbove by dotlessj;
  } ccmp_dotless;
  lookup ccmp_case {
    sub @Upper @MarkAboveLC' by @MarkAboveCase;
    sub @Upper @CombBelow @MarkAboveLC' by @MarkAboveCase;
    sub @MarkAboveCase @MarkAboveLC' by @MarkAboveCase;
    sub @Upper horncomb' by horncomb.case;
  } ccmp_case;
} ccmp;

feature locl {
  script latn;
  language ROM;
    sub uni015E by uni0218; sub uni015F by uni0219; sub uni0162 by uni021A; sub uni0163 by uni021B;
  language MOL;
    sub uni015E by uni0218; sub uni015F by uni0219; sub uni0162 by uni021A; sub uni0163 by uni021B;
  language CAT;
    sub l periodcentered' l by periodcentered.loclCAT;
    sub L periodcentered' L by periodcentered.loclCAT.case;
  script cyrl;
  language SRB;
    sub uni0431 by uni0431.loclSRB;
  language MKD;
    sub uni0431 by uni0431.loclSRB;
} locl;

feature pnum {
  sub @FigTab by @Fig;
  sub zero.zero.tf by zero.zero;
  sub period.tf by period; sub comma.tf by comma; sub colon.tf by colon; sub colon.case.tf by colon.case;
} pnum;
feature tnum {
  sub @Fig by @FigTab;
  sub zero.zero by zero.zero.tf;
  sub period by period.tf; sub comma by comma.tf; sub colon by colon.tf; sub colon.case by colon.case.tf;
} tnum;
feature zero {
  sub zero by zero.zero;
  sub zero.tf by zero.zero.tf;
} zero;
feature numr {
  sub @Fig by @Numr;
  sub @FigTab by @Numr;
} numr;
feature dnom {
  sub @Fig by @Dnom;
  sub @FigTab by @Dnom;
} dnom;
feature sups {
  sub @Fig by @Sups;
  sub @FigTab by @Sups;
} sups;
feature subs {
  sub @Fig by @Subs;
  sub @FigTab by @Subs;
} subs;
feature sinf {
  sub @Fig by @Subs;
  sub @FigTab by @Subs;
} sinf;
feature frac {
  lookup frac_bar {
    sub @FigAll slash' @FigAll by fraction;
  } frac_bar;
  lookup frac_numr1 {
    sub @Fig' fraction by @Numr;
    sub @FigTab' fraction by @Numr;
  } frac_numr1;
  lookup frac_numr2 {
    sub @Fig' @Numr fraction by @Numr;
    sub @FigTab' @Numr fraction by @Numr;
  } frac_numr2;
  lookup frac_numr3 {
    sub @Fig' @Numr @Numr fraction by @Numr;
    sub @FigTab' @Numr @Numr fraction by @Numr;
  } frac_numr3;
  lookup frac_numr4 {
    sub @Fig' @Numr @Numr @Numr fraction by @Numr;
    sub @FigTab' @Numr @Numr @Numr fraction by @Numr;
  } frac_numr4;
  lookup frac_numr5 {
    sub @Fig' @Numr @Numr @Numr @Numr fraction by @Numr;
    sub @FigTab' @Numr @Numr @Numr @Numr fraction by @Numr;
  } frac_numr5;
  lookup frac_numr6 {
    sub @Fig' @Numr @Numr @Numr @Numr @Numr fraction by @Numr;
    sub @FigTab' @Numr @Numr @Numr @Numr @Numr fraction by @Numr;
  } frac_numr6;
  lookup frac_dnom {
    sub fraction @Fig' by @Dnom;
    sub fraction @FigTab' by @Dnom;
    sub @Dnom @Fig' by @Dnom;
    sub @Dnom @FigTab' by @Dnom;
  } frac_dnom;
} frac;
feature ordn {
  sub @FigAll [a o]' by [ordfeminine ordmasculine];
} ordn;

feature case {
  sub hyphen by hyphen.case;
  sub endash by endash.case;
  sub emdash by emdash.case;
  sub parenleft by parenleft.case;
  sub parenright by parenright.case;
  sub bracketleft by bracketleft.case;
  sub bracketright by bracketright.case;
  sub braceleft by braceleft.case;
  sub braceright by braceright.case;
  sub colon by colon.case;
  sub guilsinglleft by guilsinglleft.case;
  sub guilsinglright by guilsinglright.case;
  sub guillemotleft by guillemotleft.case;
  sub guillemotright by guillemotright.case;
  sub periodcentered by periodcentered.case;
  sub bullet by bullet.case;
  sub exclamdown by exclamdown.case;
  sub questiondown by questiondown.case;
  sub at by at.case;
  sub colon.tf by colon.case.tf;
} case;

feature calt {
  sub @FigAll colon' @FigAll by colon.case;
  sub @FigAll colon.tf' @FigAll by colon.case.tf;
} calt;

